#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""向当前 Chat 发送一个文件。用法: channel-send-file "/绝对路径/文件" """
import sys, os, glob
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _channel_io import send_frame
if len(sys.argv) < 2:
    print("用法: channel-send-file \"/绝对路径/文件\"", file=sys.stderr); sys.exit(2)
arg = " ".join(sys.argv[1:]).strip()
# 去掉可能带的中文引号/通配展开
arg = arg.strip('"').strip("'")
matches = sorted(glob.glob(arg))
path = os.path.realpath(matches[0] if matches else arg)
if not os.path.isfile(path):
    print(f"错误：文件不存在 {path}", file=sys.stderr); sys.exit(2)
send_frame("file", path)
